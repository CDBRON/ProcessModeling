   <bpmn:task id="Bridge_6_2621" name="Once the department's budget is officially allocated, it can be used to fund new initiatives, such as offering customer credit lines; therefore, the credit company initiates its process when a customer submits a request for funds that falls within the approved budget parameters." /><bpmn:sequenceFlow id="Flow_P2B_6" sourceRef="atom_5_Task_1" targetRef="Bridge_6_2621" /><bpmn:sequenceFlow id="Flow_B2C_6" sourceRef="Bridge_6_2621" targetRef="atom_6_sid-C680EFA9-2BEC-43DA-9EE0-201A85F6F4DA" /></bpmn:process>
