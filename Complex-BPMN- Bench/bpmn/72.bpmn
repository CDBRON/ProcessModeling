    <bpmn:task id="Bridge_2_382b" name="To transition from Process A to Process B, the outcome of the doctor's evaluation must logically trigger a new context where the individual seeks employment. Here is a transition sentence that connects the two processes:&#10;&#10;**&quot;Once the medical evaluation and associated payments are finalized, the patient is discharged and must seek new employment, initiating the job search process.&quot;**" /><bpmn:sequenceFlow id="Flow_P2B_2" sourceRef="atom_1_sid-3BC2C363-0FE3-403C-AA16-FA8017E62C73" targetRef="Bridge_2_382b" /><bpmn:sequenceFlow id="Flow_B2C_2" sourceRef="Bridge_2_382b" targetRef="atom_2_ExclusiveGateway_5" /><bpmn:task id="atom_3_Task_1" name="Complete orientation">
      <bpmn:incoming>atom_3_SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>atom_3_SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
