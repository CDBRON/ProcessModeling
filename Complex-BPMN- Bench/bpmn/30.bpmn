      <bpmn:task id="Bridge_1_a362" name="Based on the completed order (including selected items and confirmed payment) generated in Process A, the SO: Angebot/Auftrag receives this as the subsidiary order that initiates Process B for fulfillment and invoicing." /><bpmn:sequenceFlow id="Flow_P2B_1" sourceRef="atom_0_ExclusiveGateway_2" targetRef="Bridge_1_a362" /><bpmn:sequenceFlow id="Flow_B2C_1" sourceRef="Bridge_1_a362" targetRef="atom_1_sid-57430BB6-CEED-4FBE-8913-1CDD1E32B695" /><bpmn:task id="atom_2_Task_1" name="Enter restaurant">
