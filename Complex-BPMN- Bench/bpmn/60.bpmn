   <bpmn:task id="Bridge_1_96c0" name="Based on the logical flow where a credit note from a reimbursement process would be received as an invoice by the vendor, the transition is:&#10;&#10;**Upon completion of the reimbursement process, the resulting credit note is received by the admin office in SSP, initiating the invoice processing workflow.**" /><bpmn:sequenceFlow id="Flow_P2B_1" sourceRef="atom_0_sid-A92F1CA8-27BA-41F6-8232-D46524F9AAC9" targetRef="Bridge_1_96c0" /><bpmn:sequenceFlow id="Flow_B2C_1" sourceRef="Bridge_1_96c0" targetRef="atom_1_sid-7A022777-C61A-44FF-9F2E-E9C3882C3B68" /><bpmn:task id="atom_2_Task_1" name="Submit documents">
