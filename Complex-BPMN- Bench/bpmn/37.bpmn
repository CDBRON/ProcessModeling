    <bpmn:task id="Bridge_4_13d7" name="The transition from Process A to Process B is triggered when a resolved complaint involves a formal warranty or insurance claim, which is then registered in the claims system to initiate the structured settlement review." /><bpmn:sequenceFlow id="Flow_P2B_4" sourceRef="atom_3_ExclusiveGateway_1" targetRef="Bridge_4_13d7" /><bpmn:sequenceFlow id="Flow_B2C_4" sourceRef="Bridge_4_13d7" targetRef="atom_4_Task_1" /><bpmn:task id="atom_5_Task_1" name="check case">
