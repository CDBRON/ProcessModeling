      <bpmn:task id="Bridge_5_69fd" name="Having debited the guest's account for the room‑service order, the hotel's system automatically invites the guest to register for a new service. This invitation initiates the visitor‑registration process, beginning with the guest filling out a registration form." /><bpmn:sequenceFlow id="Flow_P2B_5" sourceRef="atom_4_Task_8" targetRef="Bridge_5_69fd" /><bpmn:sequenceFlow id="Flow_B2C_5" sourceRef="Bridge_5_69fd" targetRef="atom_5_sid-9F6C21B6-58B3-4033-9CB4-AB54861D6BA1" /><bpmn:task id="atom_6_Task_1" name="Customer brings a defective computer">
