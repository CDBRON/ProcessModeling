  <bpmn:task id="Bridge_2_02c0" name="Here's the transition sentence:&#10;&#10;**&quot;Once the packaged goods are successfully shipped and begin arriving at their destination, the recipient can initiate the contract project, which immediately requires sourcing various parts from multiple web shops to begin assembly.&quot;**&#10;&#10;This sentence logically connects Process A (goods shipping) to Process B (contract parts sourcing) by showing how the completion of shipping triggers the start of a project that needs parts, thus setting up the need to query multiple web shops as described in Process B." /><bpmn:sequenceFlow id="Flow_P2B_2" sourceRef="atom_1_Task_7" targetRef="Bridge_2_02c0" /><bpmn:sequenceFlow id="Flow_B2C_2" sourceRef="Bridge_2_02c0" targetRef="atom_2_ExclusiveGateway_1" /></bpmn:process>
