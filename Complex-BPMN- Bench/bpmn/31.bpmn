  <bpmn:task id="Bridge_3_820c" name="Following the successful completion of the web design and development process, the approved website often requires supporting IT infrastructure and tools, which initiates Process B when departments submit IT solution requests to implement the necessary software and hardware systems." /><bpmn:sequenceFlow id="Flow_P2B_3" sourceRef="atom_2_sid-83763C07-3804-4220-B40B-712CFAD16C61" targetRef="Bridge_3_820c" /><bpmn:sequenceFlow id="Flow_B2C_3" sourceRef="Bridge_3_820c" targetRef="atom_3_Task_5" /><bpmn:extensionElements />
